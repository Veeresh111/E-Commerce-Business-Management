# Backend environment variables — copy to .env and fill in real values

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or local)
MONGO_URI=mongodb://localhost:27017/ecommerce

# Cache (Upstash Redis or local redis://localhost:6379)
UPSTASH_REDIS_URL=redis://localhost:6379

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh

# Image storage (Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payments (Stripe dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (SMTP provider, e.g. Resend / SendGrid / Gmail app password)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@yourstore.com
